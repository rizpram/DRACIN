APP_PORT=8080
CAPTAIN_API_URL=https://captain.sapimu.au
CAPTAIN_API_TOKEN=replace-with-a-rotated-token
CAPTAIN_TIMEOUT_MS=20000
SANSEKAI_API_URL=https://api.sansekai.my.id

# API saving mode
DRACIN_CACHE_FEED_SECONDS=300
DRACIN_CACHE_SEARCH_SECONDS=300
DRACIN_CACHE_DETAIL_SECONDS=1800
DRACIN_CACHE_EPISODES_SECONDS=3600
DRACIN_CACHE_STREAM_SECONDS=180
DRACIN_CACHE_STALE_SECONDS=21600

# Optional shared Redis/Upstash cache. If unset, DRACIN falls back to in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV-compatible names are also supported:
KV_REST_API_URL=
KV_REST_API_TOKEN=
DRACIN_CACHE_PREFIX=dracin

# Monetization
# off | adsense | sponsor | hybrid
NEXT_PUBLIC_MONETIZATION_MODE=hybrid
# Public AdSense publisher/client identifier used by the Google loader.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9886009042389859
# Add the ad unit slot IDs created in AdSense when available.
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_DISCOVER_SLOT=
NEXT_PUBLIC_ADSENSE_SEARCH_SLOT=
NEXT_PUBLIC_ADSENSE_PROVIDER_SLOT=
NEXT_PUBLIC_ADSENSE_DETAIL_SLOT=
NEXT_PUBLIC_ADSENSE_WATCH_SLOT=

# Optional direct sponsor. In hybrid mode, a complete sponsor placement takes priority over AdSense.
# Each placement requires TITLE + URL; CTA is optional.
NEXT_PUBLIC_SPONSOR_HOME_TITLE=
NEXT_PUBLIC_SPONSOR_HOME_URL=
NEXT_PUBLIC_SPONSOR_HOME_CTA=
NEXT_PUBLIC_SPONSOR_DISCOVER_TITLE=
NEXT_PUBLIC_SPONSOR_DISCOVER_URL=
NEXT_PUBLIC_SPONSOR_DISCOVER_CTA=
NEXT_PUBLIC_SPONSOR_SEARCH_TITLE=
NEXT_PUBLIC_SPONSOR_SEARCH_URL=
NEXT_PUBLIC_SPONSOR_SEARCH_CTA=
NEXT_PUBLIC_SPONSOR_PROVIDER_TITLE=
NEXT_PUBLIC_SPONSOR_PROVIDER_URL=
NEXT_PUBLIC_SPONSOR_PROVIDER_CTA=
NEXT_PUBLIC_SPONSOR_DETAIL_TITLE=
NEXT_PUBLIC_SPONSOR_DETAIL_URL=
NEXT_PUBLIC_SPONSOR_DETAIL_CTA=
NEXT_PUBLIC_SPONSOR_WATCH_TITLE=
NEXT_PUBLIC_SPONSOR_WATCH_URL=
NEXT_PUBLIC_SPONSOR_WATCH_CTA=

# Keep the real Saweria widget URL only in deployment environment variables, not in the public repository.
NEXT_PUBLIC_SAWERIA_QR_URL=
NEXT_PUBLIC_SAWERIA_URL=
